POSTGRES_PORT=55433
DATABASE_URL=postgresql+psycopg://hr:hr@127.0.0.1:55433/hr_assistant
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-with-a-long-random-token
API_USER_ID=00000000-0000-0000-0000-000000000002
# New organizations can register only when explicitly enabled.
ALLOW_REGISTRATION=false
SESSION_HOURS=24
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
EXTERNAL_API_TIMEOUT=15
EXTERNAL_USER_AGENT=AIHRAssistant/0.2
AI_WORKFLOW_TIMEOUT=30

# Authorization key from the GigaChat developer account (Base64, without "Basic ").
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TIMEOUT=30
# Optional PEM bundle with the trusted CA chain; TLS verification is always enabled.
GIGACHAT_CA_BUNDLE=
